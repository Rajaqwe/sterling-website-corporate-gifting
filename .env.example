# ==============================================================================
# STERLING CORPORATE - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development, or add to Vercel dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000" # Use https://yourdomain.com in production

# ------------------------------------------------------------------------------
# 2. DATABASE (Supabase PostgreSQL / Prisma 7)
# ------------------------------------------------------------------------------
# In Prisma v7, this is handled via the '@prisma/adapter-pg' pooling logic
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Supabase)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY is required for admin server actions that bypass RLS
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 4. PAYMENTS (Stripe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# The webhook secret obtained via stripe listen or the Stripe Dashboard
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 5. PAYMENTS (Razorpay - For Indian B2B Clients)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
# Required for secure webhook validation
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ------------------------------------------------------------------------------
	# 6. EMAILS (Resend)
	# ------------------------------------------------------------------------------
	RESEND_API_KEY="re_..."

# ------------------------------------------------------------------------------
# 7. RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Optional, but heavily recommended for production. Enables distributed rate limits.
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
