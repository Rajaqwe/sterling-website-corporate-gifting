# ==============================================================================
# STERLING CORPORATE - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development, or add to Vercel dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000" # Use https://yourdomain.com in production

# ------------------------------------------------------------------------------
# 2. DATABASE (Supabase PostgreSQL / Prisma 7)
# ------------------------------------------------------------------------------
# DATABASE_URL = Supabase shared Transaction Pooler connection.
# Copy the EXACT connection string from Supabase Dashboard -> Connect ->
# Transaction pooler. Shared transaction mode uses port 6543 and the username
# format postgres.[PROJECT-REF]. For Prisma, append ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[EXACT-POOLER-HOST]:6543/postgres?pgbouncer=true"

# DIRECT_URL = direct Postgres connection used by Prisma CLI/migrations.
# Copy the exact direct connection string from Supabase Dashboard -> Connect.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. CUSTOMER CONTACT
# ------------------------------------------------------------------------------
# Full WhatsApp Business number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER="919054935136"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION (Supabase)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY is required for admin server actions that bypass RLS
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 5. PAYMENTS (Stripe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# The webhook secret obtained via stripe listen or the Stripe Dashboard
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 6. PAYMENTS (Razorpay - For Indian B2B Clients)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
# Required for secure webhook validation
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ------------------------------------------------------------------------------
# 7. EMAILS (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_..."

# ------------------------------------------------------------------------------
# 8. RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Optional, but heavily recommended for production. Enables distributed rate limits.
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
